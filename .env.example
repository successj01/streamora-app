# Streamora frontend environment
# Copy this file to `.env.local` in the streamora/ directory and fill in real values.

# Backend API base URL (without trailing /api)
REACT_APP_API_URL=http://localhost:5000/api

# Socket.IO server URL (leave blank to auto-detect from API_URL)
REACT_APP_SOCKET_URL=

# Firebase config — used for Google sign-in and phone OTP verification.
# 1. Go to https://console.firebase.google.com → add a project (or use an existing one).
# 2. In Project Settings → General, find your web app's config and paste the values below.
# 3. In Project Settings → Service accounts, download the JSON key for the backend
#    (backend/.env uses FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=